@bind("isin",  "csv useHeaders=false", "/../dataset",  "ISIN.csv").
@bind("cusip", "csv useHeaders=false", "/../dataset", "CUSIP.csv").
@bind("figi",  "csv useHeaders=false", "/../dataset",  "FIGI.csv").
@bind("sedol", "csv useHeaders=false", "/../dataset", "SEDOL.csv").

@glossary("/../glossary/short_glossary.json").
% @glossary("/../glossary/long_glossary.json").
% @glossary("/../glossary/empty_glossary.json").

@input("isin").
@input("cusip").
@input("figi").
@input("sedol").

% 1-4: introduce a fresh internal ID for each external identifier
% 1
id(I, ISIN, N, D, C, T)   :- isin(ISIN, N, D, C, T).
% 2
id(I, CUSIP, N, D, C, T) :- cusip(CUSIP, N, D, C, T).
% 3
id(I, FIGI, N, D, C, T)   :- figi(FIGI, N, D, C, T).
% 4
id(I, SEDOL, N, D, C, T) :- sedol(SEDOL, N, D, C, T).

% 5: unify internal IDs when two records share all semantic fields but differ on the external code
@softbinding I1 = I2 :-
    id(I1, ID1, N1, D1, C1, T1),
    id(I2, ID2, N2, D2, C2, T2),
    ID1 <> ID2,
    N1 = N2,
    D1 = D2,
    C1 = C2,
    T1 = T2.

@output("id").
@executionMode("softchase").

