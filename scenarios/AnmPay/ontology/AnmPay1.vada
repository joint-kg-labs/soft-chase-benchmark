@bind("pmt", "csv useHeaders=true", "/../dataset", "payments.csv").
@bind("acc", "csv useHeaders=true", "/../dataset", "accounts.csv").

@input("pmt").
@input("acc").

# 1: link payments to originator and beneficiary IBANs
@softbinding p(ID, IBNO, IBNB, PR, A, T) :-
    pmt(ID, BICO, BICB, NO1, NB1, PR, A, T),
    acc(IBNO, NO2, BICO),
    acc(IBNB, NB2, BICB),
    NO1 = NO2, NB1 = NB2.

# 2: introduce an (initially unknown) category for each payment
cat(ID, PR, A, T, C) :-
    p(ID, IBNO, IBNB, PR, A, T).

# 3–5: assign one of b2b, c2b, c2c based on the free-text reason
@softbinding C = "b2b" :-
    cat(ID, PR, A, T, C), PR ≅ "Business to Business".
@softbinding C = "c2b" :-
    cat(ID, PR, A, T, C), PR ≅ "Customer to Business".
@softbinding C = "c2c" :-
    cat(ID, PR,, A, T, C), PR ≅ "Customer to Customer".

@output("cat").
@executionMode("distributed").
