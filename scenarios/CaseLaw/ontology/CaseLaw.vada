% ====================
% Bindings
% ====================

@bind("cases", "csv useHeaders=false", "C:\\Users\\matte\\Documents\\ClonedProjects\\SoftChaseBenchmark\\soft-chase-benchmark\\scenarios\\CaseLaw\\dataset\\600", "cases.csv").
@bind("newcase", "csv useHeaders=false", "C:\\Users\\matte\\Documents\\ClonedProjects\\SoftChaseBenchmark\\soft-chase-benchmark\\scenarios\\CaseLaw\\dataset\\600", "new_cases.csv").

@bind("cites", "csv useHeaders=true", "C:\\Users\\matte\\Documents\\ClonedProjects\\SoftChaseBenchmark\\soft-chase-benchmark\\scenarios\\CaseLaw\\dataset\\600", "cites_fixed.csv").


@glossary("C:\\Users\\matte\\Documents\\ClonedProjects\\SoftChaseBenchmark\\soft-chase-benchmark\\scenarios\\CaseLaw\\glossary\\short_glossary.json").


@input("cases").
@input("newcase").
@input("cites").
@mapping("cites", 0, "from", "int").
@mapping("cites", 1, "to", "int").

% ====================

@softbinding mayCite(IDN, IDC) :-
    newcase(IDN, _, Offense1),
    cases(IDC, _, Offense2, _, _, _),
    Offense1=Offense2.

% ====================
% 4: Each new case should cite another one
shouldCite(IDN, IDO) :- mayCite(IDN, IDO).

% ====================
% 5: Transitive closure of "should cite"
shouldCite(IDN, ID) :-
    shouldCite(IDN, IDO),
    cites(IDO, ID).    

% ====================
% Q: Relevant cases for new case (conviction condition)
@softbinding relevantCase(IDN, IDC, Name) :-
    shouldCite(IDN, IDC),
    cases(IDC, Name, _, _, Decision, _),
    Decision = "Affirmed".

@output("relevantCase").
@bind("relevantCase",  "csv useHeaders=false", "C:\\Users\\matte\\Documents\\ClonedProjects\\SoftChaseBenchmark\\soft-chase-benchmark\\scenarios\\CaseLaw\\chase\\short",  "relevantCase.csv").

@executionMode("softchase").


