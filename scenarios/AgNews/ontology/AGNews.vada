# ====================
# Bindings
# ====================

@bind("news", "csv useHeaders=true", "/../dataset", "agnews.csv").

# news: id,title,news_description

@input("news").

# ====================
# 1: Extract Business news
busNews(ID, Title, Txt) :-
    news(ID, Title, Txt),
    Txt ≅ "Business".

# ====================
# 2: Extract Stock-related news from Business
stckNews(ID, Title, Txt) :-
    busNews(ID, Title, Txt),
    Txt ≅ "Stocks".

# ====================
# 3: Positive statements → Pump
pump(ID, Title, Txt) :-
    stckNews(ID, Title, Txt),
    Txt ≅ "Positive Sentiment".

# ====================
# 4: Negative statements → Dump
dump(ID, Title, Txt) :-
    stckNews(ID, Title, Txt),
    Txt ≅ "Negative Sentiment".

# ====================
# Output
# ====================
@output("pump").
@bind("pump", "csv", "/../dataset", "pump.csv").
@output("dump").
@bind("dump", "csv", "/../dataset", "dump.csv").

@executionMode("distributed").
