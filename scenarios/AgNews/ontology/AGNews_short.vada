% ====================
% Bindings
% ====================

@bind("news", "csv useHeaders=false", "C:\\Users\\matte\\Documents\\ClonedProjects\\SoftChaseBenchmark\\soft-chase-benchmark\\scenarios\\AgNews\\dataset", "agnews500_fixed.csv").
@glossary("C:\\Users\\matte\\Documents\\ClonedProjects\\SoftChaseBenchmark\\soft-chase-benchmark\\scenarios\\AgNews\\glossary\\short_glossary.json").
% @examples("C:\\Users\\matte\\Documents\\ClonedProjects\\SoftChaseBenchmark\\soft-chase-benchmark\\scenarios\\AgNews\\prompt\\examples.json").

% news: id,title,news_description

@input("news").

% ====================
% 1: Extract Business news
@softbinding busNews(ID, Title, Txt) :- news(ID, Title, Txt), Txt ~ "Business".

% ====================
% 2: Extract Stock-related news from Business
@softbinding stckNews(ID, Title, Txt) :- busNews(ID, Title, Txt), Txt ~ "Stocks".

% ====================
% 3: Positive statements → Pump
@softbinding pump(ID, Title, Txt) :- stckNews(ID, Title, Txt), Txt ~ "Positive Sentiment".

% ====================
% 4: Negative statements → Dump
@softbinding  dump(ID, Title, Txt) :- stckNews(ID, Title, Txt), Txt ~ "Negative Sentiment".

% ====================
% Output
% ====================
@output("pump").
@bind("pump", "csv", "C:\\Users\\matte\\Documents\\ClonedProjects\\SoftChaseBenchmark\\soft-chase-benchmark\\scenarios\\AgNews\\chase\\short", "pump.csv").
@output("dump").
@bind("dump", "csv", "C:\\Users\\matte\\Documents\\ClonedProjects\\SoftChaseBenchmark\\soft-chase-benchmark\\scenarios\\AgNews\\chase\\short", "dump.csv").

@executionMode("softchase").
